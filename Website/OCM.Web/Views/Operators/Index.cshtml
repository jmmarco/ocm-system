@model OCM.API.Utils.PaginatedCollection<OCM.API.Common.Model.OperatorInfo>
@using Microsoft.AspNetCore.Http;

@{
    ViewBag.Title = "Operator Directory";
    var keyword = ViewData["keyword"] as string;
    var countryId = ViewData["countryId"] as int?;
    var isSignedIn = Context.Session.GetInt32("UserID").HasValue;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-8">
            <h2 class="mb-2">Operator directory</h2>
            <p class="text-muted mb-4">Browse charging-network operators listed in Open Charge Map.</p>

            <div class="card mb-4">
                <div class="card-header h5 mb-0">Find an operator</div>
                <div class="card-body">
                    @using (Html.BeginForm("Index", "Operators", FormMethod.Get))
                    {
                        <div class="form-row align-items-end">
                            <div class="form-group col-md-5 mb-md-0">
                                <label for="keyword">Operator name</label>
                                <input type="search" id="keyword" name="keyword" value="@keyword" class="form-control" placeholder="Search by operator name" minlength="2" />
                            </div>
                            <div class="form-group col-md-5 mb-md-0">
                                <label for="countryId">Country</label>
                                @Html.DropDownList("countryId", (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.CountryList, new { @class = "custom-select" })
                            </div>
                            <div class="form-group col-md-2 mb-0">
                                <button type="submit" class="btn btn-outline-secondary btn-block form-control">Apply</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (ViewBag.SearchTooShort == true)
            {
                <div class="alert alert-danger">Enter at least 2 characters to search.</div>
            }
            else if (!Model.Any())
            {
                <div class="alert alert-info">No matching operators found.</div>
            }
            else
            {
                var operatorCountries = (IDictionary<int, string>)ViewBag.OperatorCountries;
                var operatorActions = (IDictionary<int, string>)ViewBag.OperatorActions;
                <div class="card">
                    <div class="card-header h5 mb-0">@Model.TotalResults operator@(Model.TotalResults == 1 ? "" : "s")</div>
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Country</th>
                                    <th scope="col">Operator</th>
                                    <th scope="col">Website</th>
                                    @if (isSignedIn)
                                    {
                                        <th scope="col" class="text-right">Action</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                        @foreach (var item in Model)
                        {
                            var websiteLabel = item.WebsiteURL;
                            if (Uri.TryCreate(item.WebsiteURL, UriKind.Absolute, out var websiteUri))
                            {
                                websiteLabel = websiteUri.Host;
                            }
                            <tr>
                                <td>@operatorCountries[item.ID]</td>
                                <td>
                                    <a class="text-body" href="@Url.Action("Details", "Operators", new { id = item.ID })">
                                        <strong>@item.Title</strong>
                                    </a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.WebsiteURL))
                                    {
                                        <a href="@item.WebsiteURL" target="_blank" rel="noopener noreferrer">@websiteLabel</a>
                                    }
                                </td>
                                @if (isSignedIn)
                                {
                                    <td class="text-right">
                                        @if (operatorActions[item.ID] == "admin-edit")
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@Url.RouteUrl("AdminOperatorEdit", new { id = item.ID })">Edit</a>
                                        }
                                        else if (operatorActions[item.ID] == "country-edit")
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", "CountryOperators", new { id = item.ID })">Edit</a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", "OperatorProposals", new { operatorId = item.ID })">Suggest a correction</a>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-3" aria-label="Operator results">
                        <ul class="pagination">
                            <li class="page-item@(!Model.HasPreviousPage ? " disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { keyword, countryId, pageIndex = Model.PageIndex - 1 })">Previous</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link">Page @Model.PageIndex of @Model.TotalPages</span></li>
                            <li class="page-item@(!Model.HasNextPage ? " disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { keyword, countryId, pageIndex = Model.PageIndex + 1 })">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
